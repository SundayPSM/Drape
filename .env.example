# ─── Backend ──────────────────────────────────────────────────────────────────
# Supabase — get these from: Supabase Dashboard → Settings → Database
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase — get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here   # Settings → API → JWT Secret

REDIS_URL=redis://localhost:6379/0

# Replicate (AI try-on)
REPLICATE_API_TOKEN=r8_your_token_here
REPLICATE_WEBHOOK_SECRET=your_webhook_secret_here

# AWS S3 (or Cloudflare R2 — compatible API)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=drape-assets
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=        # leave blank for AWS, set for R2/MinIO

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://drape.app

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Drape
VITE_APP_URL=http://localhost:5173
# Supabase — same values as backend
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
